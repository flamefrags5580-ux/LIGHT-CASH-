# Environment variables example
# Copy this file to .env.local and fill in values. DO NOT commit real keys.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=pk.your_public_anon_key
# Required for running tests that need service privileges (do NOT commit)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional local dev
VITE_APP_NAME="LIGHT CASH"
